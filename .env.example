# Copy this file to `.env` for local development.
# These values are examples only. Never commit the resulting `.env` file.

# Matching defaults to the deterministic, zero-cost implementation.
MATCHING_BACKEND=deterministic
GENAI_TOP_K=10

# Optional Open WebUI integration. Required only when MATCHING_BACKEND=openwebui.
OPENWEBUI_URL=https://openwebui.invalid
OPENWEBUI_API_KEY=replace-only-for-optional-local-use
OPENWEBUI_TIMEOUT=30

# Authentication mode for local runs: "dev" (no Auth0 tenant needed, accepts
# dev-<subject> bearer tokens) or "auth0" (verifies tokens against Auth0).
AUTH_MODE=dev

# Auth0 configuration. Required when AUTH_MODE=auth0; not needed for demo/dev mode.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/
AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Frontend API routing and optional unauthenticated fixture mode.
VITE_API_URL=http://localhost:80
VITE_WS_URL=http://localhost:80/ws
VITE_DEMO_MODE=false
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret used only for container-to-container API calls. Never expose it to the browser.
INTERNAL_SERVICE_TOKEN=replace-with-a-local-random-token

# Local database and admin tooling. Choose unique local-only values.
POSTGRES_USER=sportmatcher
POSTGRES_PASSWORD=replace-with-a-local-password
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-password

# Prebuilt image repository used by ansible/docker-compose.yml.
IMAGE_REPOSITORY=ghcr.io/bechirboujelbene/sportmatcher
IMAGE_TAG=latest
